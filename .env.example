PROJECT_NAME="Trading Platform"
DEBUG=True
API_V1_STR="/api/v1"

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=trading_password
POSTGRES_DB=trading_db
DATABASE_URL=postgresql+asyncpg://trading_user:trading_password@postgres:5432/trading_db

SECRET_KEY=change_this_to_a_very_secure_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TRADE_TOPIC=trades_topic

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_password
MONGO_DB=email_logs_db
MONGO_URI=mongodb://mongo_user:mongo_password@mongodb:27017/email_logs_db?authSource=admin

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@tradingplatform.local
